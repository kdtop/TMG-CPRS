function VitalsEnterDLG(
        const aBroker:THEVDRedirector;
        aPatient,
        aLocation,
        aTemplate,
        aSignature:String;
        aDateTime:TDateTime;
        aPatientName,
        aPatientInfo:String): Integer; export; stdcall;
begin
  Result := -1;
  try
      RPCBroker := aBroker;
      Result := VitalsInputDLG(
        aPatient,
        aLocation,
        aTemplate,
        aSignature,
        aDateTime,
        aPatientName,
        aPatientInfo
        );
  except
  end;
end;

