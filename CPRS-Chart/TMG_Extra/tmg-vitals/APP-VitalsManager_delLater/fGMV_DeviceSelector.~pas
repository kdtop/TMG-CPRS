  Forms,
  u_Common,
  Dialogs,
  StdCtrls,
  ComCtrls,
  mGMV_Lookup;

type
  TfrmGMV_DeviceSelector = class(TForm)
    fraDevice: TfraGMV_Lookup;
    lblDevice: TLabel;
    dtpDate: TDateTimePicker;
    dtpTime: TDateTimePicker;
    Label1: TLabel;
    btnCancel: TButton;
    btnOK: TButton;
    procedure FormCreate(Sender: TObject);
    procedure fraDeviceExit(Sender: TObject);
    procedure btnOKClick(Sender: TObject);
    procedure dtpTimeChange(Sender: TObject);
    procedure dtpDateChange(Sender: TObject);
  private
    fDeviceString: string;
    fQueueDateTime: Double;
    CurrentTime: TDateTime;
  public
    { Public declarations }
  end;

  TFMDateTime = Double;

//function GetKernelDevice(Broker: TRPCBroker; var DeviceString: string; var QueueDateTime: TFMDateTime): Boolean;
function GetKernelDevice(var DeviceString: string; var QueueDateTime: TFMDateTime): Boolean;

implementation

uses uGMV_User;

{$R *.DFM}

//function GetKernelDevice(Broker: TRPCBroker; var DeviceString: string; var QueueDateTime: TFMDateTime): Boolean;
function GetKernelDevice(var DeviceString: string; var QueueDateTime: TFMDateTime): Boolean;
begin
  with TfrmGMV_DeviceSelector.Create(Application) do
    try
//      fraDevice.InitFrame(Broker, '3.5', GMVUser.Setting[usLastVistAPrinter]);
      fraDevice.InitFrame('3.5', GMVUser.Setting[usLastVistAPrinter]);
      btnOK.Enabled := (fraDevice.IEN <> '');
      Result := (ShowModal = mrOK);
      if Result then
        begin
          DeviceString := fDeviceString;
          QueueDateTime := fQueueDateTime;
        end;
    finally
      free;
    end;
end;

procedure TfrmGMV_DeviceSelector.FormCreate(Sender: TObject);
begin
  CurrentTime := Now;
  dtpDate.DateTime := CurrentTime;
  dtpDate.MinDate := trunc(CurrentTime);
  dtpTime.DateTime := CurrentTime;
end;

procedure TfrmGMV_DeviceSelector.fraDeviceExit(Sender: TObject);
begin
  fraDevice.FrameExit(Sender);
  btnOK.Enabled := (fraDevice.IEN <> '');
  btnOK.Default := (btnOk.Enabled);
end;

procedure TfrmGMV_DeviceSelector.btnOKClick(Sender: TObject);
begin
  GMVUser.Setting[usLastVistaPrinter] := fraDevice.IEN;
  fDeviceString := fraDevice.edtValue.Text;
  {Code to later add the subtype and iom/iosl
     + ';' +
    GetFMData(GMVBroker, '3.5', fraDevice.IENS, '3') + ';' +
    GetFMData(GMVBroker, '3.5', fraDevice.IENS, '9') + ';' +
    GetFMData(GMVBroker, '3.5', fraDevice.IENS, '11');
   }
  fQueueDateTime := WindowsDateTimeToFMDateTime(trunc(dtpDate.Date) + (dtpTime.Time - trunc(dtpTime.Date)));
  ModalResult := mrOK;
end;

procedure TfrmGMV_DeviceSelector.dtpTimeChange(Sender: TObject);
begin
  if trunc(dtpDate.Date) + frac(dtpTime.Time) < CurrentTime then
    dtpTime.DateTime := CurrentTime;
end;

procedure TfrmGMV_DeviceSelector.dtpDateChange(Sender: TObject);
begin
  try
    if dtpDate.DateTime < CurrentTime then
      dtpDate.DateTime := CurrentTime;
  except
  end;
end;

end.

